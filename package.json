{
    "name": "ghl-elements",
    "version": "1.0.0",
    "description": "A framework for building custom element behavior on GoHighLevel pages",
    "type": "module",
    "license": "Apache-2.0",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/types/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "highlevel",
        "gohighlevel",
        "dom",
        "elements",
        "stripe"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/mdeancline/ghl-elements"
    },
    "scripts": {
        "clean": "node clean.mjs",
        "build:types": "tsc --project tsconfig.json",
        "build:js": "node build.mjs",
        "build": "npm run clean && npm run build:js && npm run build:types",
        "prepublishOnly": "npm run build",
        "ship:dry": "npm run build && npm publish --dry-run --access public",
        "ship:prod": "npm run build && npm publish --access public"
    },
    "peerDependencies": {
        "@stripe/stripe-js": ">=9.0.0",
        "typescript": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        }
    },
    "dependencies": {
        "ts-essentials": "^10.2.0",
        "weakref": "^0.2.4"
    },
    "devDependencies": {
        "@stripe/stripe-js": "^9.3.1",
        "chalk": "^5.6.2",
        "esbuild": "^0.28.0",
        "typescript": "^5.7.2",
        "weakref": "^0.2.4"
    }
}