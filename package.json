{
    "name": "ghl-elements",
    "version": "0.1.0",
    "description": "A framework for building custom element behavior on GoHighLevel pages",
    "type": "module",
    "license": "Apache-2.0",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/types/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "highlevel",
        "gohighlevel",
        "dom",
        "elements",
        "stripe"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/mdeancline/ghl-elements"
    },
    "scripts": {
        "build:types": "tsc --project tsconfig.json",
        "build:js": "node build.mjs",
        "build": "npm run build:js && npm run build:types",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "@stripe/stripe-js": ">=9.0.0"
    },
    "dependencies": {
        "ts-essentials": "^10.2.0"
    },
    "devDependencies": {
        "@stripe/stripe-js": "^9.3.1",
        "typescript": "^6.0.3",
        "weakref": "^0.2.4"
    }
}