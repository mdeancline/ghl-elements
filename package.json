{
    "name": "@mdcline/ghl-elements",
    "version": "1.0.0",
    "description": "A framework for building custom element behavior on GoHighLevel pages",
    "author": "Matthew Cline",
    "type": "module",
    "license": "Apache-2.0",
    "sideEffects": false,
    "packageManager": "npm@9.1.3",
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/ghl-elements.d.ts"
        }
    },
    "files": [
        "dist/index.js",
        "dist/ghl-elements.d.ts"
    ],
    "keywords": [
        "highlevel",
        "gohighlevel",
        "dom",
        "elements",
        "stripe"
    ],
    "homepage": "https://github.com/mdeancline/ghl-elements#readme",
    "bugs": {
        "url": "https://github.com/mdeancline/ghl-elements/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mdeancline/ghl-elements.git"
    },
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "clean": "node clean.mjs",
        "build:types": "tsc --project tsconfig.json",
        "build:js": "node build.mjs",
        "build": "npm run clean && npm run build:js && npm run build:types",
        "build:pack": "npm run build && npm pack",
        "rebuild": "npm run clean && npm run build",
        "prepublishOnly": "npm run build",
        "ship:dry": "npm run build && npm publish --dry-run --access public",
        "ship:prod": "npm run build && npm publish --access public"
    },
    "peerDependencies": {
        "@stripe/stripe-js": ">=6.0.0 <7.0.0",
        "typescript": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "@stripe/stripe-js": {
            "optional": true
        },
        "typescript": {
            "optional": true
        }
    },
    "dependencies": {
        "ts-deferred": "^1.0.4",
        "weakref": "^0.2.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@microsoft/api-extractor": "^7.58.9",
        "@stripe/stripe-js": "^9.3.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/jsdom": "^28.0.3",
        "@vitest/coverage-v8": "^4.1.7",
        "chalk": "^5.6.2",
        "esbuild": "^0.28.0",
        "eslint": "^10.5.0",
        "jsdom": "^29.1.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.61.1",
        "vitest": "^4.1.7"
    }
}