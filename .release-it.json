{
    "plugins": {
        "@release-it/conventional-changelog": {
            "preset": "angular",
            "infile": "CHANGELOG.md"
        }
    },
    "hooks": {
        "before:init": "npm run build"
    },
    "git": {
        "commitMessage": "chore: release ${version}",
        "tagName": "v${version}"
    },
    "github": {
        "release": true,
        "releaseName": "v${version}",
        "releaseNotes": null
    },
    "npm": {
        "publish": true,
        "publishArgs": [
            "--access public"
        ]
    }
}